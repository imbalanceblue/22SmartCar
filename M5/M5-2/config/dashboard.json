{
  "_comment": "dashboard.yaml 的 JSON 孪生:无 pyyaml 环境的降级路径,字段与 YAML 完全一致",
  "topic_patterns": [
    "/perception/**",
    "/navigation/**",
    "/control/**",
    "/hw/**",
    "/referee/**"
  ],
  "topics": {
    "/perception/targets": 10.0,
    "/navigation/pose": 2.0,
    "/referee/status": 1.0
  },
  "special_topics": {
    "task_state": "/dashboard/task_state",
    "system_ready": "/system_ready"
  },
  "publish": {
    "metrics_hz": 10,
    "faults_topic": "/dashboard/faults"
  },
  "fault_rules": {
    "camera_freq_ratio": 0.5,
    "camera_window_s": 3.0,
    "topic_timeout_s": 3.0,
    "cpu_high_pct": 85.0,
    "temp_high_c": 85.0,
    "voltage_low_v": 10.5
  },
  "video": {
    "enable": false,
    "hz": 1,
    "width": 320,
    "height": 240
  }
}
